+	SetAbsOrigin( vecOrigin );
+	SetAbsVelocity( vecVelocity );
+	SetAbsAngles( QAngle( 0.0f, flEyeYaw, 0.0f ) );
+	SetCycle( flCycle );
+	SetPlaybackRate( flPlaybackRate );
+	m_flSimulationTime = flSimulationTime;
+	m_Shared.BoneWorkerSetConditionBits( conditions[0], conditions[1], conditions[2], conditions[3], conditions[4] );
+}
