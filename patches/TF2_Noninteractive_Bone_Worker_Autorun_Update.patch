+// Command-line jobs are intentionally started only after the client has
+// completed sign-on to the worker's local map. Source executes ordinary '+foo'
+// startup commands too early and may drop all but their first argument.
+class CTFBoneWorkerAutoRunner : public CAutoGameSystemPerFrame
+{
+public:
+	CTFBoneWorkerAutoRunner() : CAutoGameSystemPerFrame( "CTFBoneWorkerAutoRunner" ), m_bAttempted( false ), m_nReadyFrames( 0 ) {}
+
+	virtual void Update( float frametime ) OVERRIDE
+	{
+		if ( m_bAttempted )
+			return;
+
+		const char *inputPath = CommandLine()->ParmValue( "-tf_bone_worker_input", "" );
+		const char *outputPath = CommandLine()->ParmValue( "-tf_bone_worker_output", "" );
+		if ( !inputPath[0] && !outputPath[0] )
+			return;
+
+		if ( !inputPath[0] || !outputPath[0] )
+		{
+			m_bAttempted = true;
+			Warning( "TF bone worker: both -tf_bone_worker_input and -tf_bone_worker_output are required.\n" );
+			engine->ClientCmd_Unrestricted( "quit\n" );
+			return;
+		}
+
+		if ( !engine->IsConnected() || !engine->IsInGame() )
+			return;
+
+		// Give client entities a few completed frames after sign-on.
+		if ( ++m_nReadyFrames < 5 )
+			return;
+
+		m_bAttempted = true;
+		const char *levelName = engine->GetLevelName();
+		if ( !levelName || V_stricmp( levelName, "maps/tf_bone_worker.bsp" ) )
+		{
+			Warning( "TF bone worker: refusing to run outside the local worker map (current level: %s).\n",
+				levelName ? levelName : "<none>" );
+			engine->ClientCmd_Unrestricted( "quit\n" );
+			return;
+		}
+
+		Msg( "TF bone worker: client sign-on complete on local map; starting animation job.\n" );
+		CTFBoneWorker worker;
+		bool success = worker.Run( inputPath, outputPath );
+		if ( !success )
+			Warning( "TF bone worker did not complete successfully.\n" );
+		engine->ClientCmd_Unrestricted( "quit\n" );
+	}
+
+private:
+	bool m_bAttempted;
+	int m_nReadyFrames;
+};
+
+static CTFBoneWorkerAutoRunner g_TFBoneWorkerAutoRunner;
+
